"""The streaming APIs used here; dynamic JSON values require validation."""

from collections.abc import Iterable, Iterator
from typing import Any, BinaryIO, Protocol

class JSONError(Exception): ...

class ReadableStream(Protocol):
    def read(self, size: int = ..., /) -> bytes: ...

def items(
    source: ReadableStream | Iterable[tuple[str, str, Any]],
    prefix: str,
    *,
    use_float: bool = ...,
) -> Iterator[Any]: ...
def kvitems(
    source: BinaryIO, prefix: str, *, use_float: bool = ...
) -> Iterator[tuple[str, Any]]: ...
def parse(
    source: BinaryIO, *, use_float: bool = ...
) -> Iterator[tuple[str, str, Any]]: ...
