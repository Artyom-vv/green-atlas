+/* Resolve modeler data through the active datidx, not the physical order of
+   blobs (old saved records may still exist in the section). ODA DWG spec
+   24.2.2.1-3. This path handles inline records; paged blobs fail explicitly. */
+int
+dwg_decode_acds_sab (Bit_Chain *dat, Dwg_Data *dwg)
+{
+  Dwg_AcDs *acds = &dwg->acds;
+  BITCODE_BL i, attached = 0;
+  for (i = 0; i < acds->datidx.num_entries; i++)
+    {
+      Dwg_AcDs_DataIndex_Entry *entry = &acds->datidx.entries[i];
+      Dwg_AcDs_SegmentIndex *index;
+      Dwg_AcDs_Segment *segment;
+      Dwg_Object *object;
+      Dwg_Entity_3DSOLID *solid;
+      Bit_Chain cursor = *dat;
+      BITCODE_RLL handle;
+      BITCODE_RL record_size, data_offset, data_size;
+      size_t start, stop, base, position;
+      if (!entry->segidx)
+        continue;
+      if (entry->segidx >= acds->num_segidx)
+        return DWG_ERR_VALUEOUTOFBOUNDS;
+      index = &acds->segidx[entry->segidx];
+      segment = &acds->segments[entry->segidx];
+      if (!index->offset || index->offset > dat->size
+          || index->size < 48 || index->size > dat->size - index->offset
+          || segment->type != 2)
+        return DWG_ERR_VALUEOUTOFBOUNDS;
+      start = (size_t)index->offset;
+      stop = start + index->size;
+      /* datidx local offsets are relative to the segment's content header. */
+      if (entry->offset > index->size - 48
+          || index->size - 48 - entry->offset < 20)
+        return DWG_ERR_VALUEOUTOFBOUNDS;
+      cursor.byte = start + 48 + entry->offset;
+      cursor.bit = 0;
+      record_size = bit_read_RL (&cursor);
+      (void)bit_read_RL (&cursor); /* flags */
+      handle = bit_read_RLL (&cursor);
+      data_offset = bit_read_RL (&cursor);
+      object = dwg_resolve_handle_silent (dwg, handle);
+      if (!object || !dwg_obj_is_3dsolid (object)
+          || !object->tio.entity->has_ds_data)
+        continue; /* Non-modeler schemas (e.g. block thumbnails). */
+      if (record_size != 20)
+        return DWG_ERR_NOTYETSUPPORTED;
+      if (segment->objdata_algn_offset > index->size / 16)
+        return DWG_ERR_VALUEOUTOFBOUNDS;
+      base = start + (size_t)segment->objdata_algn_offset * 16;
+      if (base < cursor.byte || data_offset > stop - base
+          || stop - base - data_offset < 4)
+        return DWG_ERR_VALUEOUTOFBOUNDS;
+      position = base + data_offset;
+      cursor.byte = position;
+      data_size = bit_read_RL (&cursor);
+      if (data_size == 0xbb106bb1)
+        {
+          LOG_ERROR ("AcDs paged SAB requires indexed blob01 support: "
+                     FORMAT_RLL, handle);
+          return DWG_ERR_NOTYETSUPPORTED;
+        }
+      if (data_size < 15 || data_size > stop - cursor.byte)
+        return DWG_ERR_VALUEOUTOFBOUNDS;
+      /* Respect the next physical record boundary, including inactive rows. */
+      if (start + 48 + entry->offset + 40 <= base)
+        {
+          Bit_Chain next = cursor;
+          next.byte = start + 48 + entry->offset + 20;
+          if (bit_read_RL (&next) == 20)
+            {
+              BITCODE_RL next_offset;
+              next.byte += 12;
+              next_offset = bit_read_RL (&next);
+              if (next_offset <= data_offset || next_offset > stop - base
+                  || (size_t)data_size + 4 > next_offset - data_offset)
+                return DWG_ERR_VALUEOUTOFBOUNDS;
+            }
+        }
+      if (memcmp (&dat->chain[cursor.byte], "ASM BinaryFile", 14)
+          && memcmp (&dat->chain[cursor.byte], "ACIS BinaryFile", 15))
+        return DWG_ERR_NOTYETSUPPORTED;
+      solid = object->tio.entity->tio._3DSOLID;
+      if (solid->acis_data || solid->sab_size)
+        return DWG_ERR_INVALIDHANDLE; /* Never overwrite an ambiguous owner. */
+      solid->acis_data = (BITCODE_RC *)malloc (data_size);
+      if (!solid->acis_data)
+        return DWG_ERR_OUTOFMEM;
+      memcpy (solid->acis_data, &dat->chain[cursor.byte], data_size);
+      solid->sab_size = data_size;
+      solid->version = 2;
+      solid->acis_empty = 0;
+      attached++;
+      LOG_INFO ("AcDs indexed SAB: handle " FORMAT_RLL ", bytes %u\n",
+                handle, data_size);
+    }
+  /* Pending handles are validation evidence, never an ordering heuristic. */
+  while (dwg->num_acis_sab_hdl)
+    {
+      BITCODE_H ref = SHIFT_HV (dwg, num_acis_sab_hdl, acis_sab_hdl);
+      Dwg_Object *object = dwg_resolve_handle_silent (dwg, ref->handleref.value);
+      free (ref);
+      if (!object || !dwg_obj_is_3dsolid (object)
+          || !object->tio.entity->tio._3DSOLID->sab_size)
+        return DWG_ERR_INVALIDHANDLE;
+    }
+  for (i = 0; i < dwg->num_objects; i++)
+    {
+      Dwg_Object *object = &dwg->object[i];
+      if (dwg_obj_is_3dsolid (object) && object->tio.entity->has_ds_data
+          && !object->tio.entity->tio._3DSOLID->sab_size)
+        return DWG_ERR_INVALIDHANDLE;
+    }
+  LOG_INFO ("AcDs indexed modeler bodies: %u\n", attached);
+  return 0;
 }
 
