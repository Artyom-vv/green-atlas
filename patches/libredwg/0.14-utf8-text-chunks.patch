+/* A DXF text continuation must not split a UTF-8 code point: readers decode
+   each group separately before joining MTEXT/embedded ATTRIB content. */
+enum { DXF_STRING_CHUNK_BYTES = 250 };
+static size_t
+dxf_utf8_chunk_length (const char *str, size_t remaining)
+{
+  size_t length = remaining < DXF_STRING_CHUNK_BYTES
+                      ? remaining : DXF_STRING_CHUNK_BYTES;
+  if (length < remaining)
+    while (length && (((unsigned char)str[length] & 0xc0) == 0x80))
+      length--;
+  /* Invalid runs of continuation bytes must not cause an infinite loop. */
+  return length ? length : DXF_STRING_CHUNK_BYTES;
+}
