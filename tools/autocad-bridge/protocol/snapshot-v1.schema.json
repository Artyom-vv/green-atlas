{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://green-atlas.local/schemas/autocad-snapshot-v1.json",
  "title": "Green Atlas native CAD snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "extraction", "coverage", "geometry", "summary"],
  "properties": {
    "schema": {"const": "green-atlas.autocad-snapshot/1"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "saved", "units_code", "document_revision"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "saved": {"const": true},
        "units_code": {"type": "integer", "minimum": 0},
        "document_revision": {"type": "string", "minLength": 1}
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["autocad_version", "plugin_version", "target", "projection", "requested_tolerance_m"],
      "properties": {
        "autocad_version": {"type": "string", "minLength": 1},
        "plugin_version": {"type": "string", "minLength": 1},
        "target": {"enum": ["macos-arm64", "windows-x86_64"]},
        "projection": {"enum": ["wcs-xy-planar"]},
        "requested_tolerance_m": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/dependency"}
    },
    "coverage": {
      "type": "array",
      "items": {"$ref": "#/$defs/coverage"}
    },
    "geometry": {
      "type": "array",
      "items": {"$ref": "#/$defs/geometry"}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_instances", "native", "converted", "context", "unresolved", "payload_sha256", "complete"],
      "properties": {
        "source_instances": {"type": "integer", "minimum": 0},
        "native": {"type": "integer", "minimum": 0},
        "converted": {"type": "integer", "minimum": 0},
        "context": {"type": "integer", "minimum": 0},
        "unresolved": {"type": "integer", "minimum": 0},
        "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "complete": {"const": true}
      }
    }
  },
  "$defs": {
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "sha256", "bytes", "record_handle", "block_name", "stored_path"],
      "properties": {
        "id": {"type": "string", "pattern": "^xref/[0-9A-F]+$"},
        "kind": {"const": "xref"},
        "path": {"type": "string", "minLength": 1, "maxLength": 2048},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1},
        "record_handle": {"type": "string", "pattern": "^[0-9A-F]+$"},
        "block_name": {"type": "string", "minLength": 1},
        "stored_path": {"type": "string", "minLength": 1}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handle", "instance_chain"],
      "properties": {
        "handle": {"type": "string", "pattern": "^[0-9A-F]+$"},
        "instance_chain": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:[0-9A-F]+|MINSERT:[0-9A-F]+:R[0-9]+:C[0-9]+)$"
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "entity_type", "layer", "status", "method", "geometry_ids"],
      "properties": {
        "identity": {"$ref": "#/$defs/identity"},
        "entity_type": {"type": "string", "minLength": 1},
        "layer": {"type": "string"},
        "status": {"enum": ["native", "converted", "context", "unresolved"]},
        "method": {"type": "string", "minLength": 1},
        "reason": {"type": ["string", "null"]},
        "geometry_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "dependency_ids": {
          "type": ["array", "null"],
          "items": {"type": "string", "pattern": "^xref/[0-9A-F]+$"}
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "identity", "kind", "loops", "native_area_units2", "native_perimeter_units", "achieved_tolerance_m", "content_sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "identity": {"$ref": "#/$defs/identity"},
        "kind": {"enum": ["region"]},
        "loops": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "closed", "coordinates"],
            "properties": {
              "role": {"enum": ["outer", "hole"]},
              "closed": {"const": true},
              "coordinates": {
                "type": "array",
                "minItems": 4,
                "items": {
                  "type": "array",
                  "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}],
                  "items": false,
                  "minItems": 3,
                  "maxItems": 3
                }
              }
            }
          }
        },
        "native_area_units2": {"type": "number", "minimum": 0},
        "native_perimeter_units": {"type": "number", "minimum": 0},
        "achieved_tolerance_m": {"type": "number", "minimum": 0},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
